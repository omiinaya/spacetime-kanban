# ── Core ──
STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=spacetimedb-kanban
SERVER_PORT=8727
CORS_ORIGIN=http://localhost:5189

# ── GitHub (optional — for issue sync) ──
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# ── Webhook alerts ──
# Discord: create a webhook at Channel Settings > Integrations > Webhooks
# Slack: create a Slack webhook URL
WEBHOOK_DEFAULT_URL=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_SECONDS=10

# ── Scheduler (background lifecycle — replaces cron jobs) ──
SCHEDULER_ENABLED=true
DISPATCHER_INTERVAL_SECONDS=30
STALE_CHECK_INTERVAL_SECONDS=120
DEAD_BOARD_INTERVAL_SECONDS=900
METRICS_INTERVAL_SECONDS=900
TEMPLATE_INTERVAL_SECONDS=900

# ── Worker (optional — enables automatic task execution) ──
# Set WORKER_SCRIPT to enable the dispatcher loop
# Example: WORKER_SCRIPT=/home/user/kanban-worker.py
WORKER_COMMAND=python3
WORKER_SCRIPT=
MIN_WORKERS=4
MAX_WORKERS=24
MAX_MEMORY_PCT=80
STALE_MINUTES=20

# ── Agent identity ──
AGENT_ID=hermes
API_KEY=
