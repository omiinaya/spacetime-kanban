# ═══════════════════════════════════════════════════════════════
# spacetime-kanban — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and edit for your environment.
# See CONFIGURATION.md for detailed documentation of all options.
# ═══════════════════════════════════════════════════════════════

# ── SpacetimeDB Connection ────────────────────────────────────
STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=kanban
# KANBAN_STDB_RETRIES=60

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8727
CORS_ORIGIN=http://localhost:4444

# ── Authentication ────────────────────────────────────────────
# API_KEY=your-secret-key    # Leave empty to disable (NOT for production)

# ── Agent Identity ────────────────────────────────────────────
# AGENT_ID=hermes
# KANBAN_AGENT_ID=           # CLI override (takes priority)

# ── Scheduler (Background Tasks) ──────────────────────────────
# SCHEDULER_ENABLED=true
# DISPATCHER_INTERVAL_SECONDS=5
# STALE_CHECK_INTERVAL_SECONDS=120
# DEAD_BOARD_INTERVAL_SECONDS=3600
# TEMPLATE_INTERVAL_SECONDS=900
# METRICS_INTERVAL_SECONDS=900
# SCANNER_INTERVAL_SECONDS=1800
# IMPROVER_INTERVAL_SECONDS=3600
# REMEDIATOR_INTERVAL_SECONDS=3600

# ── Task Fountain / Seed Repos ────────────────────────────────
# KANBAN_REPOS=spacetime-kanban    # Comma-separated repos the fountain/seed targets

# ── Worker Subprocesses ──────────────────────────────────────
# WORKER_COMMAND=python3
# WORKER_SCRIPT=
# WORKER_ARGS=
# MIN_WORKERS=2
# MAX_WORKERS=8
# STALE_MINUTES=45
# MAX_MEMORY_PCT=80
# Isolate each task in its own git worktree (1=on, 0=work in main clone)
# KANBAN_WORKTREE=1
# Verify the repo's tests pass before marking a task done (1=on, 0=off)
# KANBAN_VERIFY_TESTS=1
# KANBAN_VERIFY_TESTS_TIMEOUT=180

# ── Webhook Alerts ───────────────────────────────────────────
# WEBHOOK_DEFAULT_URL=https://discord.com/api/webhooks/...
# WEBHOOK_MAX_RETRIES=3
# WEBHOOK_TIMEOUT_SECONDS=10

# ── GitHub Integration ───────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_DEFAULT_REPO=owner/sample-repo

# ── MCP / Internal API ───────────────────────────────────────
# KANBAN_API=http://localhost:8727
# KANBAN_LLM_WORKER=hermes chat -Q -q
