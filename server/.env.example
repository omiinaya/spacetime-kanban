# ═══════════════════════════════════════════════════════════════
# SpacetimeDB Kanban — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and edit for your environment.
# See CONFIGURATION.md for detailed documentation of all options.
# ═══════════════════════════════════════════════════════════════

# ── SpacetimeDB Connection ────────────────────────────────────
STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=kanban
# KANBAN_STDB_RETRIES=60

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8727
CORS_ORIGIN=http://localhost:4444

# ── Authentication ────────────────────────────────────────────
# API_KEY=your-secret-key    # Leave empty to disable (NOT for production)

# ── Agent Identity ────────────────────────────────────────────
# AGENT_ID=hermes
# KANBAN_AGENT_ID=           # CLI override (takes priority)

# ── Scheduler (Background Tasks) ──────────────────────────────
# SCHEDULER_ENABLED=true
# DISPATCHER_INTERVAL_SECONDS=30
# STALE_CHECK_INTERVAL_SECONDS=120
# DEAD_BOARD_INTERVAL_SECONDS=900
# TEMPLATE_INTERVAL_SECONDS=900
# METRICS_INTERVAL_SECONDS=900
# SCANNER_INTERVAL_SECONDS=21600
# IMPROVER_INTERVAL_SECONDS=3600

# ── Worker Subprocesses ──────────────────────────────────────
# WORKER_COMMAND=python3
# WORKER_SCRIPT=
# WORKER_ARGS=
# MIN_WORKERS=1
# MAX_WORKERS=3
# STALE_MINUTES=35
# MAX_MEMORY_PCT=80

# ── Webhook Alerts ───────────────────────────────────────────
# WEBHOOK_DEFAULT_URL=https://discord.com/api/webhooks/...
# WEBHOOK_MAX_RETRIES=3
# WEBHOOK_TIMEOUT_SECONDS=10

# ── GitHub Integration ───────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_DEFAULT_REPO=omiinaya/spacetimedb-tv

# ── MCP / Internal API ───────────────────────────────────────
# KANBAN_API=http://localhost:8727
# KANBAN_LLM_WORKER=hermes chat -Q -q
