# ── SpacetimeDB Kanban — environment configuration ──
# Copy this file to .env and fill in your values

# SpacetimeDB connection
STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=kanban

# Server
SERVER_PORT=8727
CORS_ORIGIN=http://localhost:4444

# ── Agent identity ──
# AGENT_ID=hermes

# ── Scheduler (background tasks inside server process) ──
SCHEDULER_ENABLED=true
DISPATCHER_INTERVAL_SECONDS=30
STALE_CHECK_INTERVAL_SECONDS=120
DEAD_BOARD_INTERVAL_SECONDS=900
TEMPLATE_INTERVAL_SECONDS=900
METRICS_INTERVAL_SECONDS=900
SCANNER_INTERVAL_SECONDS=21600  # Repo improvement scanner (6h default, 0=disable)

# ── Worker configuration ──
WORKER_COMMAND=python3
# WORKER_SCRIPT=server/workers/run.py     # Path to worker entry point
# WORKER_ARGS=-m server.workers.run        # Alternative to WORKER_SCRIPT
MIN_WORKERS=1
MAX_WORKERS=3
MAX_MEMORY_PCT=80
STALE_MINUTES=10

# ── LLM Worker config (for reasoning tasks) ──
# KANBAN_LLM_WORKER=hermes chat -Q -q

# ── Webhook alerts ──
# WEBHOOK_DEFAULT_URL=https://discord.com/api/webhooks/...

# ── GitHub integration ──
# GITHUB_TOKEN=ghp_...
# GITHUB_DEFAULT_REPO=org/repo

# ── API auth ──
# API_KEY=your-secret-key  # Set to require auth on mutation endpoints
