# ── SpacetimeDB Kanban — environment configuration ──
# Copy this file to .env and fill in your values

# SpacetimeDB connection
STDB_HOST=localhost
STDB_PORT=3001
STDB_DB=kanban

# Server
SERVER_PORT=8727
CORS_ORIGIN=http://localhost:4444

# ── Authentication ──
# API_KEY=your-secret-key  # Leave empty to disable auth (not recommended for production)

# ── STDB Proxy (used internally by the server) ──
# KANBAN_API=http://localhost:8727  # STDB HTTP proxy URL

# ── Agent identity ──
# AGENT_ID=hermes

# ── Scheduler (background tasks inside server process) ──
SCHEDULER_ENABLED=true
DISPATCHER_INTERVAL_SECONDS=30
STALE_CHECK_INTERVAL_SECONDS=120
DEAD_BOARD_INTERVAL_SECONDS=900
TEMPLATE_INTERVAL_SECONDS=900
METRICS_INTERVAL_SECONDS=900
SCANNER_INTERVAL_SECONDS=21600  # Repo improvement scanner (6h default, 0=disable)
IMPROVER_INTERVAL_SECONDS=3600  # Self-improvement agent interval
MAX_MEMORY_PCT=80  # Max memory % before throttling worker dispatch

# ── Worker configuration ──
WORKER_COMMAND=python3
# WORKER_SCRIPT=/path/to/server/workers/run.py     # Path to worker entry point
# WORKER_ARGS=                                     # Extra args (leave empty if using WORKER_SCRIPT)
MIN_WORKERS=1
MAX_WORKERS=3
STALE_MINUTES=35

# ── LLM Worker config ──
# Command for LLM-driven task workers (shlex-split into args)
# KANBAN_LLM_WORKER=hermes chat -Q -q

# ── Webhook alerts ──
# WEBHOOK_DEFAULT_URL=https://discord.com/api/webhooks/...  # Discord webhook URL
# WEBHOOK_MAX_RETRIES=3  # How many times to retry failed webhook delivery
# WEBHOOK_TIMEOUT_SECONDS=10  # Webhook delivery HTTP timeout

# ── GitHub ──
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx  # GitHub personal access token
# GITHUB_DEFAULT_REPO=omiinaya/spacetimedb-tv  # Default repo for issue sync
