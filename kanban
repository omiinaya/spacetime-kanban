def cmd_watch(args: list[str]):
    """Agent daemon — registers, heartbeats, and monitors the swarm."""
    import argparse
    p = argparse.ArgumentParser(prog="kanban watch")
    p.add_argument("--capabilities", default="", help="Comma-separated skills")
    p.add_argument("--repo", default="", help="Primary repo focus")
    p.add_argument("--daemon", action="store_true", help="Run in background")
    p.add_argument("--heartbeat-interval", type=int, default=30, help="Heartbeat interval in seconds (default: 30)")
    p.add_argument("--suggest-interval", type=int, default=60, help="Suggestion check interval in seconds (default: 60)")
    opts = p.parse_args(args)

    agent_id = detect_agent_id()
    hostname = os.uname().nodename if hasattr(os, "uname") else "unknown"
    pid_file = os.path.expanduser("~/.kanban/watch.pid")
    log_dir = os.path.expanduser("~/.kanban")
    log_file = os.path.join(log_dir, "watch.log")

    # Daemonize
    if opts.daemon:
        pid = os.fork()
        if pid > 0:
            print(f"✅ Agent daemon started (PID {pid})")
            print(f"   Log: {log_file}")
            print(f"   Stop: kill {pid} or rm -f {pid_file} && kanban watch --stop")
            # Write PID file from parent (child PID is what we need)
            os.makedirs(log_dir, exist_ok=True)
            with open(pid_file, "w") as f:
                f.write(str(pid))
            sys.exit(0)
        # Child: detach from terminal
        os.setsid()
        os.makedirs(log_dir, exist_ok=True)
        try:
            sys.stdout.close()
            sys.stderr.close()
        except:
            pass
        sys.stdout = open(log_file, "a")
        sys.stderr = open(log_file, "a")
        # Re-register PID as child
        with open(pid_file, "w") as f:
            f.write(str(os.getpid()))

    # Register
    try:
        api_post("/api/agents/register", {
            "agent_id": agent_id,
            "host": hostname,
            "capabilities": opts.capabilities,
            "repo_focus": opts.repo,
        })
        if not opts.daemon:
            print(f"🟢 Registered as {agent_id} in the swarm")
            if opts.capabilities:
                print(f"🛠️  Capabilities: {opts.capabilities}")
            if opts.repo:
                print(f"📂 Focus: {opts.repo}")
    except SystemExit:
        eprint("✗ Failed to register agent — is the kanban API running?")
        sys.exit(1)

    last_suggest_time = 0
    running = True
    loop_count = 0

    def shutdown(sig=None, frame=None):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    if not opts.daemon:
        print(f"📡 Watching (heartbeat every {opts.heartbeat_interval}s, suggest every {opts.suggest_interval}s)")
        print(f"   Press Ctrl+C to stop")

    while running:
        now_t = time.time()
        loop_count += 1

        # Heartbeat
        try:
            api_post(f"/api/agents/{agent_id}/heartbeat", {
                "agent_id": agent_id,
                "status": "online",
                "current_task_id": "",
            })
            ts = datetime.fromtimestamp(now_t).strftime("%H:%M:%S")
            if not opts.daemon:
                print(f"  📡 {ts} Heartbeat ✓")
        except:
            if not opts.daemon:
                print(f"  ⚠ {datetime.fromtimestamp(now_t).strftime('%H:%M:%S')} Heartbeat FAILED")

        # Suggestions
        if now_t - last_suggest_time >= opts.suggest_interval:
            try:
                suggestions = api_get(f"/api/tasks/suggest?limit=2")
                if suggestions and not opts.daemon:
                    for s in suggestions:
                        t = s.get("task", {})
                        score = s.get("score", 0)
                        reason = s.get("reason", "")
                        title = t.get("title", "?")
                        prio = {0: "U", 1: "H", 2: "M", 3: "L"}.get(t.get("priority", 2), "?")
                        repo = t.get("repo", "")
                        repo_tag = f" [{repo}]" if repo else ""
                        skills = t.get("required_skills", "") or ""
                        skill_tag = f" <{skills}>" if skills else ""
                        print(f"  💡 [{prio}] {title}{repo_tag}{skill_tag}")
                        print(f"     Score: {score} | {reason}")
            except:
                pass
            last_suggest_time = now_t

        # Sleep with interrupt checking
        for _ in range(opts.heartbeat_interval):
            if not running:
                break
            time.sleep(1)

    # Graceful shutdown
    ts = datetime.now().strftime("%H:%M:%S")
    if not opts.daemon:
        print(f"\n  🔴 {ts} Agent {agent_id} going offline")
    try:
        api_post(f"/api/agents/{agent_id}/heartbeat", {
            "agent_id": agent_id,
            "status": "offline",
            "current_task_id": "",
        })
    except:
        pass

    if os.path.exists(pid_file):
        try:
            os.remove(pid_file)
        except:
            pass


def cmd_dispatch(args: list[str]):
    """Auto-dispatch: find available tasks matching capabilities, claim the best."""
    import argparse
    p = argparse.ArgumentParser(prog="kanban dispatch")
    p.add_argument("--capabilities", default="", help="Comma-separated skills to match (default: auto-detect from registered agent)")
    p.add_argument("--repo", default="", help="Filter by repo")
    p.add_argument("--limit", type=int, default=1, help="Max tasks to claim (default: 1)")
    p.add_argument("--auto", action="store_true", help="Non-interactive: auto-claim without prompting")
    p.add_argument("--json", action="store_true")
    opts = p.parse_args(args)

    agent_id = detect_agent_id()

    # Get capabilities from registered agent if not specified
    caps = opts.capabilities
    if not caps:
        try:
            agent = api_get(f"/api/agents/{agent_id}")
            if isinstance(agent, dict) and agent.get("capabilities"):
                caps = agent["capabilities"]
        except:
            pass

    # Fetch suggestions from the API
    params = f"limit={opts.limit * 3}"  # fetch more to filter
    if caps:
        params += f"&agent_id={agent_id}"

    suggestions = api_get(f"/api/tasks/suggest?{params}")

    if not suggestions or not isinstance(suggestions, list):
        if opts.json:
            print(json.dumps({"status": "no_tasks", "agent": agent_id, "capabilities": caps}))
            return
        print(f"No available tasks matching capabilities: {caps or '(any)'}")
        return

    # Filter by repo if specified
    if opts.repo:
        suggestions = [s for s in suggestions if s.get("task", {}).get("repo") == opts.repo]

    if not suggestions:
        if opts.json:
            print(json.dumps({"status": "no_matches", "agent": agent_id, "filter": opts.repo}))
            return
        print(f"No tasks match repo filter: {opts.repo}")
        return

    # Sort by score descending
    suggestions.sort(key=lambda s: -(s.get("score", 0) or 0))
    to_claim = suggestions[:opts.limit]
    results = []

    if not opts.json:
        print(f"🤖 Agent: {agent_id}")
        if caps:
            print(f"🛠️  Capabilities: {caps}")
        print(f"📋 Found {len(to_claim)} task(s) to dispatch")
        print()

    for s in to_claim:
        task = s.get("task", {})
        tid = task.get("id", "")
        title = task.get("title", "?")
        score = s.get("score", 0)
        reason = s.get("reason", "")
        prio = task.get("priority", 2)
        required = task.get("required_skills", "")
        repo = task.get("repo", "")

        if opts.auto:
            # Auto-claim
            result = api_post(f"/api/tasks/{tid}/claim", {"agent_id": agent_id})
            success = isinstance(result, dict) and result.get("status") == "claimed"
            if success:
                # Add a log
                notes = f"Auto-dispatched to {agent_id} (score: {score}, caps: {caps})"
                try:
                    api_post(f"/api/tasks/{tid}/log", {
                        "task_id": tid,
                        "action": "auto-dispatched",
                        "agent_id": agent_id,
                        "notes": notes,
                    })
                except:
                    pass
                results.append({"task_id": tid, "title": title, "status": "claimed", "score": score})
                if not opts.json:
                    print(f"  ✅ [{prio}] {title}")
                    print(f"     Claimed: {tid[:24]} (score {score})")
                    if required:
                        print(f"     Skills: {required}")
                    if reason:
                        print(f"     Why: {reason}")
            else:
                results.append({"task_id": tid, "title": title, "status": "failed", "error": str(result)})
                if not opts.json:
                    print(f"  ❌ [{prio}] {title} — claim failed: {result}")
        else:
            # Interactive: show suggestion
            if not opts.json:
                print(f"  💡 [{prio}] {title}")
                print(f"     ID: {tid[:24]} | Score: {score} | Repo: {repo}")
                if required:
                    print(f"     Needs: {required}")
                if reason:
                    print(f"     Why: {reason}")
                print()

    if not opts.auto and not opts.json:
        if to_claim:
            ids = [s.get("task", {}).get("id", "")[:24] for s in to_claim]
            print(f"Run 'kanban claim <task-id>' to claim, or 'kanban dispatch --auto' for unattended")
    elif opts.auto and opts.json:
        print(json.dumps({"status": "dispatched", "agent": agent_id, "results": results}))

def cmd_webhook(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog='kanban webhook')
    sub = p.add_subparsers(dest='subcommand', required=True)
    p_list = sub.add_parser('list', help='List webhook subscriptions')
    p_list.add_argument('--json', action='store_true')
    p_add = sub.add_parser('add', help='Register a new webhook')
    p_add.add_argument('url', help='Webhook URL')
    p_add.add_argument('--type', default='generic', choices=['discord', 'slack', 'telegram', 'generic'])
    p_add.add_argument('--events', default='created,claimed,unclaimed,completed,blocked', help='Comma-separated events')
    p_add.add_argument('--label', default='', help='Human-readable label')
    p_add.add_argument('--json', action='store_true')
    p_remove = sub.add_parser('remove', help='Remove a webhook')
    p_remove.add_argument('id', help='Webhook ID')
    p_remove.add_argument('--json', action='store_true')
    opts = p.parse_args(args)
    if opts.subcommand == 'list':
        result = api_get('/api/webhooks')
        if opts.json:
            print(json.dumps(result, indent=2))
        else:
            if not result:
                print('No webhooks configured.')
                print('  Add one: kanban webhook add <url> --type=slack --events=completed,blocked')
                return
            for wh in result:
                ev = ', '.join(wh.get('events', []))
                print(f'  {wh["id"][:20]:20s} {wh["type"]:12s} {wh.get("label","")[:35]:35s}')
                print(f'  {"":20s} Events: {ev}')
                print(f'  {"":20s} URL: {wh["url"][:70]}')
                print()
    elif opts.subcommand == 'add':
        events = [e.strip() for e in opts.events.split(',') if e.strip()]
        result = api_post('/api/webhooks', {
            'url': opts.url, 'type': opts.type, 'events': events,
            'label': opts.label or f'{opts.type}:{opts.url[:40]}',
        })
        if opts.json:
            print(json.dumps(result, indent=2))
        else:
            print(f'Registered {result.get("id","?")[:20]}')
            print(f'  Type: {result.get("type","?")} | Events: {",".join(result.get("events",[]))}')
    elif opts.subcommand == 'remove':
        result = api_delete(f'/api/webhooks/{opts.id}')
        if opts.json:
            print(json.dumps(result, indent=2))
        else:
            print(f'Removed webhook {opts.id[:20]}')

