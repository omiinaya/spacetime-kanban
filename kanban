def cmd_create(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban create")
    p.add_argument("--title", required=True)
    p.add_argument("--desc", default="")
    p.add_argument("--priority", type=int, default=2)
    p.add_argument("--repo", default="")
    p.add_argument("--roadmap", default="")
    p.add_argument("--agent", default=None)
    p.add_argument("--json", action="store_true")
    opts = p.parse_args(args)
    agent = opts.agent or detect_agent_id()
    result = api_post("/api/tasks", {
        "title": opts.title,
        "description": opts.desc,
        "priority": opts.priority,
        "repo": opts.repo,
        "roadmap_item": opts.roadmap,
        "created_by": agent,
    })
    if opts.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"✅ Created task: {opts.title}")


def cmd_check_branch(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban check-branch")
    p.add_argument("branch", nargs="?", default=None)
    opts = p.parse_args(args)
    branch = opts.branch
    if not branch:
        try:
            result = subprocess.run(
                ["git", "rev-parse", "--abbrev-ref", "HEAD"],
                capture_output=True, text=True, timeout=3,
            )
            if result.returncode != 0:
                eprint("Not in a git repository")
                sys.exit(1)
            branch = result.stdout.strip()
        except Exception as e:
            eprint(f"Could not detect branch: {e}")
            sys.exit(1)
    if branch in ("main", "master", "HEAD"):
        print(f"✓ Branch '{branch}' — no kanban check needed")
        return
    m = BRANCH_PATTERN.match(branch)
    if not m:
        eprint(f"✗ Invalid branch format: {branch}")
        eprint("  Expected: {type}/kanban-{task_id}--{slug}")
        eprint("  Examples:")
        eprint("    feature/kanban-task_1748397912_abc12345--my-feature")
        eprint("    fix/kanban-task_1748397913_abc12345--bug-fix")
        sys.exit(1)
    task_id = m.group(2)
    try:
        task = api_get(f"/api/tasks/{task_id}")
    except SystemExit:
        eprint(f"✗ Kanban task not found: {task_id}")
        eprint("  Tasks must exist in the kanban before branch creation.")
        eprint("  Create one via:  kanban create --title=... --repo=...")
        sys.exit(2)
    status = task.get("status", "?")
    title = task.get("title", "?")
    assigned = task.get("assigned_to")
    if status == "available":
        print(f"⚠ Task \"{title}\" is available (not claimed)")
        print("  Claim it:  kanban claim {task_id}")
        sys.exit(0)
    if status == "done":
        eprint(f"✗ Task \"{title}\" is already DONE")
        sys.exit(2)
    if status == "blocked":
        eprint(f"✗ Task \"{title}\" is BLOCKED")
        sys.exit(2)
    agent = detect_agent_id()
    if assigned and assigned != agent:
        eprint(f"✗ Task \"{title}\" is claimed by {assigned}, not {agent}")
        sys.exit(2)
    print(f"✓ Branch '{branch}' references kanban task \"{title}\" ({status})")


def cmd_install_hooks(args: list[str]):
    git_dir = _get_git_dir()
    hooks_dir = os.path.join(git_dir, "hooks")
    hook_path = os.path.join(hooks_dir, "pre-push")
    if os.path.exists(hook_path):
        with open(hook_path) as f:
            if "kanban" in f.read():
                print(f"✓ pre-push hook already installed at {hook_path}")
                return
        print(f"⚠ {hook_path} already exists but doesn't contain kanban check.")
        print("  Append manually or remove the existing hook first.")
        sys.exit(1)
    os.makedirs(hooks_dir, exist_ok=True)
    with open(hook_path, "w") as f:
        f.write(PRE_PUSH_HOOK)
    os.chmod(hook_path, 0o755)
    print(f"✅ kanban pre-push hook installed at {hook_path}")
    print("   Branch names will be validated on every git push.")


def cmd_uninstall_hooks(args: list[str]):
    git_dir = _get_git_dir()
    hook_path = os.path.join(git_dir, "hooks", "pre-push")
    if not os.path.exists(hook_path):
        print("No pre-push hook found.")
        return
    with open(hook_path) as f:
        content = f.read()
    if "kanban" not in content:
        print(f"⚠ {hook_path} doesn't appear to be a kanban hook — skipping")
        return
    os.remove(hook_path)
    print(f"✅ Removed kanban pre-push hook from {hook_path}")


def cmd_info(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban info")
    p.add_argument("--json", action="store_true")
    opts = p.parse_args(args)
    repo_name = _detect_repo()
    tasks = api_get(f"/api/tasks?status=in_progress")
    my_tasks = [t for t in tasks if t.get("assigned_to") == detect_agent_id()]
    repo_tasks = [t for t in tasks if t.get("repo") == repo_name]
    if opts.json:
        print(json.dumps({
            "agent": detect_agent_id(),
            "repo": repo_name,
            "my_in_progress": my_tasks,
            "repo_in_progress": repo_tasks,
            "all_in_progress": tasks,
        }, indent=2))
        return
    if repo_name:
        print(f"Repo: {repo_name}")
    print(f"Agent: {detect_agent_id()}")
    print()
    if my_tasks:
        print(f"You have {len(my_tasks)} task(s) in progress:")
        for t in my_tasks:
            print(f"  {t['id'][:24]}  {t.get('title', '?')}")
    else:
        print("You have no tasks in progress.")
        print("Run:  kanban list --status=available")
    if repo_tasks:
        print(f"\n{len(repo_tasks)} in-progress task(s) in this repo:")
        for t in repo_tasks:
            a = f" [{t.get('assigned_to', '?')}]" if t.get("assigned_to") else ""
            print(f"  {t['id'][:24]}  {t.get('title', '?')[:50]}{a}")


def _get_git_dir() -> str:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            capture_output=True, text=True, timeout=3,
        )
        if result.returncode != 0:
            eprint("Not inside a git repository")
            sys.exit(1)
        return os.path.abspath(result.stdout.strip())
    except Exception as e:
        eprint(f"Could not find git directory: {e}")
        sys.exit(1)


def _detect_repo() -> str | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=3,
        )
        if result.returncode != 0:
            return None
        return os.path.basename(result.stdout.strip())
    except Exception:
        return None


COMMANDS = {
    "list": cmd_list,
    "claim": cmd_claim,
    "complete": cmd_complete,
    "block": cmd_block,
    "unclaim": cmd_unclaim,
    "create": cmd_create,
    "check-branch": cmd_check_branch,
    "install-hooks": cmd_install_hooks,
    "uninstall-hooks": cmd_uninstall_hooks,
    "info": cmd_info,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h"):
        print(__doc__)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        eprint(f"Unknown command: {cmd}")
        eprint(f"Available: {', '.join(sorted(COMMANDS))}")
        sys.exit(1)
    COMMANDS[cmd](sys.argv[2:])


if __name__ == "__main__":
    main()
