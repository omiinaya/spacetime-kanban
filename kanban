#!/usr/bin/env python3
"""kanban CLI — multi-agent task coordination across any repo.

Zero external dependencies (stdlib only). Works from any directory.
Install: copy this file to ~/.local/bin/kanban and chmod +x.

Configuration via environment variables:
  KANBAN_API_BASE   — default: http://localhost:8725
  KANBAN_AGENT_ID   — default: auto-detect (whoami or git user.name)

Usage:
  kanban list [--status=<s>] [--repo=<r>] [--json]
  kanban claim <task-id> [--agent=<a>] [--json]
  kanban complete <task-id> [--notes=<n>] [--json]
  kanban block <task-id> [--reason=<r>] [--json]
  kanban unclaim <task-id> [--json]
  kanban create --title=<t> [--desc=<d>] [--priority=<p>] [--repo=<r>] [--roadmap=<m>] [--json]
  kanban check-branch [<branch-name>]
  kanban install-hooks
  kanban uninstall-hooks
  kanban info [--json]
  kanban --help
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import urljoin

API_BASE = os.environ.get("KANBAN_API_BASE", "http://localhost:8725")
BRANCH_PATTERN = re.compile(
    r"^(feature|fix|chore|refactor|docs|test)/"
    r"kanban-([a-zA-Z0-9_]+)--"
    r"(.+)$"
)
PRE_PUSH_HOOK = """#!/bin/sh
# kanban pre-push hook — validates branch references a claimed kanban task
command -v kanban >/dev/null 2>&1 || exit 0
while read local_ref local_sha remote_ref remote_sha; do
  branch="${local_ref#refs/heads/}"
  [ -z "$branch" ] || [ "$branch" = "main" ] || [ "$branch" = "master" ] && continue
  kanban check-branch "$branch"
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "kanban: branch check failed (exit $rc)"
    echo "kanban: use 'kanban list' to find and claim available tasks"
    exit $rc
  fi
done
exit 0
"""


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def detect_agent_id() -> str:
    """Auto-detect the agent identity."""
    env = os.environ.get("KANBAN_AGENT_ID")
    if env:
        return env
    try:
        result = subprocess.run(["whoami"], capture_output=True, text=True, timeout=3)
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except Exception:
        pass
    try:
        result = subprocess.run(
            ["git", "config", "user.name"],
            capture_output=True, text=True, timeout=3,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip().lower().replace(" ", "-")
    except Exception:
        pass
    return "unknown-agent"


def api_get(path: str) -> dict | list:
    url = urljoin(API_BASE, path)
    try:
        resp = urllib.request.urlopen(url, timeout=15)
        return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        eprint(f"HTTP {e.code}: {body}")
        sys.exit(1)
    except Exception as e:
        eprint(f"Request failed: {e}")
        sys.exit(1)


def api_post(path: str, body: dict | None = None) -> dict | list:
    url = urljoin(API_BASE, path)
    data = json.dumps(body or {}).encode() if body else None
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Content-Type", "application/json")
    try:
        resp = urllib.request.urlopen(req, timeout=15)
        return json.loads(resp.read().decode()) if resp.readable() else {"status": "ok"}
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        eprint(f"HTTP {e.code}: {body}")
        sys.exit(1)
    except Exception as e:
        eprint(f"Request failed: {e}")
        sys.exit(1)


def api_patch(path: str, body: dict) -> dict:
    url = urljoin(API_BASE, path)
    data = json.dumps(body).encode()
    req = urllib.request.Request(url, data=data, method="PATCH")
    req.add_header("Content-Type", "application/json")
    try:
        resp = urllib.request.urlopen(req, timeout=15)
        return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        eprint(f"HTTP {e.code}: {body}")
        sys.exit(1)
    except Exception as e:
        eprint(f"Request failed: {e}")
        sys.exit(1)


def api_delete(path: str) -> dict:
    url = urljoin(API_BASE, path)
    req = urllib.request.Request(url, method="DELETE")
    try:
        resp = urllib.request.urlopen(req, timeout=15)
        return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        eprint(f"HTTP {e.code}: {body}")
        sys.exit(1)
    except Exception as e:
        eprint(f"Request failed: {e}")
        sys.exit(1)


def cmd_list(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban list")
    p.add_argument("--status", default=None)
    p.add_argument("--repo", default=None)
    p.add_argument("--json", action="store_true")
    opts = p.parse_args(args)
    params = {}
    if opts.status:
        params["status"] = opts.status
    if opts.repo:
        params["repo"] = opts.repo
    qs = "&".join(f"{k}={v}" for k, v in params.items())
    path = f"/api/tasks{'?' + qs if qs else ''}"
    tasks = api_get(path)
    if opts.json:
        print(json.dumps(tasks, indent=2))
        return
    if not tasks:
        print("No tasks found.")
        return
    for t in tasks:
        assigned = f" [{t.get('assigned_to', '')}]" if t.get("assigned_to") else ""
        print(f"  {t['id'][:24]:24s}  {t['status']:15s}  P{t.get('priority', 2)}  {t.get('title', '?')[:55]}{assigned}")


def cmd_claim(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban claim")
    p.add_argument("task_id")
    p.add_argument("--agent", default=None)
    p.add_argument("--json", action="store_true")
    opts = p.parse_args(args)
    agent = opts.agent or detect_agent_id()
    result = api_post(f"/api/tasks/{opts.task_id}/claim", {"agent_id": agent})
    if opts.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"✅ Claimed {opts.task_id[:24]} as {agent}")


def cmd_complete(args: list[str]):
    import argparse
    p = argparse.ArgumentParser(prog="kanban complete")
    p.add_argument("task_id")
    p.add_argument("--notes", default="")
