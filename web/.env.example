# SpacetimeDB Kanban — Frontend Environment Variables
#
# The frontend is served by the FastAPI backend at port 8727.
# In production, NO env vars are needed — the SPA is served as static files.
# In development, see the root server/.env.example for backend config.
#
# VITE_API_URL=http://localhost:8727

# Frontend port (used during development by Vite dev server)
PORT=5173
